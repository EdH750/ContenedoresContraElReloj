<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="ContenedoresContraReloj" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/ContenedoresContraReloj" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/ContenedoresContraReloj" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="include" />
			<Add directory="include/tda" />
			<Add directory="include/dominio" />
			<Add directory="include/sesion" />
		</Compiler>
		<!-- TDA -->
		<Unit filename="src/tda/abb.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="include/tda/abb.h" />
		<Unit filename="src/tda/pila.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="include/tda/pila.h" />
		<Unit filename="src/tda/cola.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="include/tda/cola.h" />
		<Unit filename="src/tda/lista.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="include/tda/lista.h" />
		<Unit filename="include/tda/nodo.h" />
		<!-- Dominio -->
		<Unit filename="src/dominio/jornada.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="include/dominio/jornada.h" />
		<Unit filename="src/dominio/escenario.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="include/dominio/escenario.h" />
		<!-- Sesion -->
		<Unit filename="src/sesion/operador.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="include/sesion/operador.h" />
		<!-- App -->
		<Unit filename="src/util.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="include/util.h" />
		<Unit filename="src/menu.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="include/menu.h" />
		<Unit filename="src/aplicacion.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="include/aplicacion.h" />
		<!-- Punto de entrada -->
		<Unit filename="main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
